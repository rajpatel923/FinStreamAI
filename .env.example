# ============================================================
# FinStreamAI — Environment Variables Template
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# --- App ---
APP_NAME=FinStreamAI API
API_V1_PREFIX=/api/v1
DEBUG=True
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finstreami
POSTGRES_USER=finstreami
POSTGRES_PASSWORD=finstreami123

# --- TimescaleDB ---
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=5433
TIMESCALEDB_DB=timescaledb
TIMESCALEDB_USER=timescale
TIMESCALEDB_PASSWORD=timescale123

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=finstreami123

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_ACKS=all
KAFKA_RETRIES=3
KAFKA_RETRY_BACKOFF_MS=500
KAFKA_BATCH_SIZE=16384
KAFKA_LINGER_MS=5
KAFKA_COMPRESSION_TYPE=snappy
KAFKA_MAX_IN_FLIGHT=5
KAFKA_ENABLE_IDEMPOTENCE=True
KAFKA_GROUP_ID=finstreami-consumers
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=False
KAFKA_MAX_POLL_RECORDS=500
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=10000

# --- Market Data APIs ---
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
POLYGON_API_KEY=your_polygon_key
POLYGON_BASE_URL=https://api.polygon.io
POLYGON_WS_URL=wss://socket.polygon.io
FINNHUB_API_KEY=your_finnhub_key
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_WS_URL=wss://ws.finnhub.io

# --- News APIs ---
NEWS_API_KEY=your_news_api_key
NEWS_API_BASE_URL=https://newsapi.org/v2/everything
THE_NEWS_API_KEY=your_the_news_api_key
GNEWS_API_KEY=your_gnews_key

# --- Social APIs ---
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=FinStreamAI/0.1
TWITTER_API_KEY=your_twitter_api_key

# --- Ingestion Runtime ---
USE_MOCK_DATA=False
WATCHED_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA,JPM
NEWS_FINANCIAL_KEYWORDS=stock,earnings,fed,market,trading
REDDIT_SUBREDDITS=wallstreetbets,stocks,investing
POLYGON_RATE_LIMIT=100
ALPHA_VANTAGE_RATE_LIMIT=5
FINNHUB_RATE_LIMIT=60
NEWS_API_RATE_LIMIT=100
HTTP_TIMEOUT_SECONDS=30.0
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF=1.0

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your-s3-bucket-name
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# --- Auth / Security ---
JWT_SECRET_KEY=your_jwt_secret_key_min_32_chars
JWT_ALGORITHM=HS256
ENCRYPTION_KEY=your_fernet_encryption_key

# --- Monitoring ---
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=finstreami123
JAEGER_ENDPOINT=http://localhost:14268/api/traces
METRICS_PORT=8001
